# Stripe payment links (server-only — set in Vercel, never expose with NEXT_PUBLIC).
# Required for the "Text Stripe payment link" button in the dispatch drawer.
# STRIPE_SECRET_KEY=sk_live_or_test_...
# SUPABASE_SERVICE_ROLE_KEY=...   # service role key; lets the API routes write bookings/queue
# NEXT_PUBLIC_SITE_URL=https://evexecoperator.vercel.app  # base for Stripe success/cancel redirects
# STRIPE_WEBHOOK_SECRET=whsec_... # signing secret from the Stripe webhook endpoint
#   Point Stripe at: https://evexecoperator.vercel.app/api/stripe-webhook
#   Subscribe to: checkout.session.completed (marks the booking Paid automatically)

# Customer confirmation bridge (server-only). When set, operator-created
# bookings get the same SMS+email+push confirmation website bookings get,
# via evexec's /api/notifications/confirm. Without these, booking creation
# still works — the confirmation call is skipped silently, and the
# operator's own status-update SMS texts still go out as normal.
# WEBSITE_API_URL=https://evexec.co.uk
# OPERATOR_ACTION_SECRET=...   # must match the SAME value set in evexec's env
